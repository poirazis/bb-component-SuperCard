{
  "type": "component",
  "metadata": {
    "svelteMajor": 5
  },
  "schema": {
    "name": "bb-component-SuperCard",
    "friendlyName": "Super Card",
    "description": "A Card component for Budibase",
    "hasChildren": true,
    "showEmptyState": false,
    "icon": "Card",
    "styles": [
      "padding",
      "size",
      "border",
      "background"
    ],
    "settings": [
      {
        "type": "select",
        "key": "cardType",
        "label": "Card Type",
        "defaultValue": "horizontal",
        "options": [
          {
            "label": "Horizontal",
            "value": "horizontal"
          },
          {
            "label": "Vertical",
            "value": "vertical"
          },
          {
            "label": "Full Image",
            "value": "image"
          }
        ]
      },
      {
        "type": "text",
        "key": "title",
        "label": "Title",
        "defaultValue": "Super Card"
      },
      {
        "type": "text",
        "key": "subtitle",
        "label": "Subtitle",
        "defaultValue": "Card Subtitle"
      },
      {
        "type": "text",
        "key": "text",
        "label": "Text",
        "defaultValue": "{{ lorem 100 }}"
      },
      {
        "type": "boolean",
        "key": "wide",
        "label": "Wide Card",
        "defaultValue": false
      },
      {
        "type": "boolean",
        "key": "padded",
        "label": "Padded",
        "dependsOn": "showImage",
        "defaultValue": true,
        "resetOn": "showImage"
      },
      {
        "section": true,
        "name": "Image Settings",
        "collapsed": true,
        "settings": [
          {
            "type": "boolean",
            "key": "showImage",
            "label": "Show Image",
            "defaultValue": true
          },
          {
            "type": "text",
            "key": "imageUrl",
            "label": "Image URL",
            "dependsOn": "showImage",
            "defaultValue": "https://picsum.photos/seed/picsum/200/300"
          },
          {
            "type": "text",
            "key": "imageSVG",
            "label": "SVG",
            "dependsOn": "showImage"
          }
        ]
      },
      {
        "section": true,
        "name": "Menu Settings",
        "collapsed": true,
        "settings": [
          {
            "type": "buttonConfiguration",
            "key": "buttons",
            "label": "Card Menu",
            "wide": true
          },
          {
            "type": "boolean",
            "key": "collapsed",
            "label": "Collapsed"
          },
          {
            "type": "icon",
            "key": "menuIcon",
            "label": "Icon",
            "defaultValue": "ri-more-2-fill",
            "dependsOn": "collapsed"
          }
        ]
      },
      {
        "section": true,
        "name": "Tag Settings",
        "collapsed": true,
        "settings": [
          {
            "type": "boolean",
            "key": "showTag",
            "label": "Show Tag",
            "defaultValue": true
          },
          {
            "type": "select",
            "key": "size",
            "label": "Size",
            "defaultValue": "small",
            "options": [
              {
                "label": "Small",
                "value": "small"
              },
              {
                "label": "Medium",
                "value": "medium"
              },
              {
                "label": "Large",
                "value": "large"
              }
            ]
          },
          {
            "type": "icon",
            "key": "tagIcon",
            "label": "Icon"
          },
          {
            "type": "text",
            "key": "tagText",
            "label": "Text",
            "defaultValue": "Tag"
          },
          {
            "type": "color",
            "key": "tagColor",
            "label": "Color",
            "defaultValue": "var(--spectrum-global-color-static-blue-800)"
          },
          {
            "type": "color",
            "key": "tagTextColor",
            "label": "Text Color",
            "defaultValue": "white"
          },
          {
            "type": "boolean",
            "key": "tagFilled",
            "label": "Filled",
            "defaultValue": true
          },
          {
            "type": "boolean",
            "key": "tagHidable",
            "label": "Hidable"
          },
          {
            "type": "event",
            "key": "onTagHide",
            "label": "On Hide",
            "dependsOn": "tagHidable"
          }
        ]
      },
      {
        "section": true,
        "name": "Footer Settings",
        "collapsed": true,
        "settings": [
          {
            "type": "boolean",
            "key": "showFooter",
            "label": "Show Footer",
            "defaultValue": true
          },
          {
            "type": "icon",
            "key": "footerIcon",
            "label": "Icon"
          },
          {
            "type": "text",
            "key": "footer",
            "label": "Text",
            "defaultValue": "Card Footer"
          },
          {
            "type": "buttonConfiguration",
            "key": "footerButtons",
            "label": "Buttons",
            "wide": true
          }
        ]
      },
      {
        "tag": "style",
        "type": "select",
        "label": "Flex Mode",
        "showLabel": false,
        "key": "flex",
        "showInBar": true,
        "barStyle": "buttons",
        "options": [
          {
            "label": "Shrink",
            "value": false,
            "barIcon": "Minimize",
            "barTitle": "Shrink container"
          },
          {
            "label": "Grow",
            "value": true,
            "barIcon": "Maximize",
            "barTitle": "Grow container"
          }
        ],
        "defaultValue": false
      }
    ]
  }
}
